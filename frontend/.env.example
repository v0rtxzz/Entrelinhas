# =====================================================================
# Variáveis de ambiente do FRONT-END
# 1. Copie este arquivo para ".env" (o .env NÃO vai para o GitHub)
# 2. Supabase > Project Settings > API
# Atenção: tudo que começa com VITE_ fica visível no navegador.
# Por isso aqui só entram chaves PÚBLICAS (nunca a service_role!).
# =====================================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Endereço do back-end.
#  - No seu computador: deixe VAZIO (o Vite repassa /api para localhost:3001)
#  - No Vercel: a URL do projeto do back-end, ex.: https://entrelinhas-api.vercel.app
VITE_API_URL=
