# =====================================================================
# Variáveis de ambiente do BACK-END
# 1. Copie este arquivo para ".env" (o .env NÃO vai para o GitHub)
# 2. Preencha com os dados do seu projeto Supabase:
#    Supabase > Project Settings > API
# =====================================================================

# URL do projeto (ex.: https://abcdefgh.supabase.co)
SUPABASE_URL=

# Chave pública "anon" / "publishable" (segura: a RLS protege os dados)
SUPABASE_ANON_KEY=

# Porta local da API
PORT=3001

# Endereço(s) do front-end autorizados a chamar a API (CORS).
# Separe vários por vírgula. Em produção, coloque a URL do Vercel.
FRONTEND_URL=http://localhost:5173
